# Copy to .env.local and adjust. Never commit .env.local.

# Where the dev server forwards API calls (see vite.config.ts)
STM_MIDDLEWARE_URL=http://localhost:8080
STM_CALL_CONTROL_URL=http://localhost:8090

# Per-teller approval limit shown in the video console. Must match callcontrol.teller-limit in call-control.
VITE_TELLER_LIMIT=5000
# Must match recording.required-above in call-control: approvals at or above this need a healthy recording.
VITE_RECORDING_REQUIRED_ABOVE=1000
